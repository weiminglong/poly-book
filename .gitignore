# Build
/target/
# cargo-fuzz: build artifacts, generated corpus, and crash artifacts are all
# regenerated locally and must never be committed (the root /target/ rule is
# anchored and does not cover the nested fuzz/ workspace).
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Data
/data/

# Environment
.env
.env.*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code (local agent config)
.claude/

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
infra/terraform.tfvars

# Profiling
*.profraw
perf.data
perf.data.old
flamegraph.svg

# Ad-hoc compiled binaries: throwaway executables built at the repo root for
# manual experiments (e.g. `rustc x.rs -o test_overflow`) must never be tracked.
/test_overflow
/verify
